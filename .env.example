# Copy to .env and fill in. Never commit .env (tokens leaked from this repo's history in 2019-2020).

# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID: Developer Portal -> your app -> General Information
DISCORD_CLIENT_ID=
# Server to register slash commands in (guild commands update instantly; global ones take up to an hour)
DISCORD_GUILD_ID=

# Optional: /annonce posts through this webhook (Server Settings -> Integrations -> Webhooks -> Copy URL)
ANNOUNCE_WEBHOOK_URL=

# Optional: reaction roles. Message to watch, and emoji=roleId pairs separated by commas.
REACTION_ROLES_MESSAGE_ID=
REACTION_ROLES=👍=000000000000000000,😋=000000000000000000,👀=000000000000000000
